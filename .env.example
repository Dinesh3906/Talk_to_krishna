# ==============================================================================
# Talk to Krishna - Environment Configuration Example
# Copy this file to .env and populate with real configuration values
# NEVER commit .env with production credentials to source control.
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000

# Database Configuration (PostgreSQL + pgvector)
# Default matches docker-compose.yml service definition
DATABASE_URL=postgresql://krisna_user:krisna_password@localhost:5432/talk_to_krisna_db

# AI Provider Configuration
# Supported providers: gemini, openai, anthropic (Fail-closed: requires valid API key)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL_NAME=gemini-1.5-pro
EMBEDDING_MODEL_NAME=text-embedding-004

# Authentication Configuration (e.g., Supabase / JWT)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
AUTH_URL=https://your-project.supabase.co
AUTH_KEY=your-supabase-anon-or-service-key

# Analytics (Optional)
POSTHOG_KEY=your_posthog_project_api_key
POSTHOG_HOST=https://app.posthog.com

# In-App Purchases / Subscriptions (Optional)
REVENUECAT_KEY=your_revenuecat_google_api_key

# Mobile App Config (for apps/mobile/.env)
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_APP_NAME="Talk to Krishna"

# Email / OTP Delivery Configuration (Resend)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="Talk to Krishna <contact@codealgo.live>"
