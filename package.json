{
  "name": "talk-to-krisna",
  "version": "3.2.0",
  "private": true,
  "description": "Production-quality mobile application & RAG conversational AI inspired by Lord Krishna and the Mahabharata",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "npm --workspace=services/api run dev",
    "dev:mobile": "npm --workspace=apps/mobile run dev",
    "build": "npm run build:packages && npm --workspace=services/api run build && npm --workspace=apps/mobile run build",
    "build:packages": "npm --workspace=packages/shared run build",
    "build:api": "npm run build:packages && npm --workspace=services/api run build",
    "build:web": "npm run build:packages && npm --workspace=apps/mobile run build",
    "start": "npm --workspace=services/api run start",
    "start:api": "npm --workspace=services/api run start",
    "lint": "npm --workspaces run lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm --workspace=services/api run db:migrate",
    "ingest:corpus": "npm --workspace=services/api run ingest:corpus",
    "ingest:pdf": "npm --workspace=services/api run ingest:pdf",
    "ingest:child": "npm --workspace=services/api run ingest:child"
  },
  "dependencies": {
    "query-string": "7.1.3",
    "zod": "^3.24.2"
  },
  "keywords": [
    "krishna",
    "mahabharata",
    "bhagavad-gita",
    "rag",
    "react-native",
    "expo",
    "pgvector",
    "ai-companion"
  ],
  "author": "Talk to Krishna Engineering Team",
  "license": "UNLICENSED"
}
