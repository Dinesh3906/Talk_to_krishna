{
  "name": "@talk-to-krisna/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm --prefix ../../packages/shared run build",
    "build": "node -e \"const fs=require('fs'); if(fs.existsSync('dist')){fs.rmSync('dist',{recursive:true,force:true});}\" && tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/db',{recursive:true}); fs.cpSync('src/db/migrations','dist/db/migrations',{recursive:true});\"",
    "build:api": "npm run build",
    "build:web": "npm --prefix ../.. install && npm --prefix ../.. run build:web && node -e \"const fs=require('fs'); fs.mkdirSync('apps/mobile',{recursive:true}); fs.cpSync('../../apps/mobile/dist','apps/mobile/dist',{recursive:true});\"",
    "start": "node dist/index.js",
    "start:api": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:eval": "tsx src/eval/run-evaluation.ts",
    "ingest:corpus": "tsx src/modules/ingestion/seed-corpus-cli.ts",
    "ingest:pdf": "tsx src/modules/ingestion/ingest-pdf-cli.ts",
    "ingest:full": "tsx src/modules/ingestion/run-full-ingestion-cli.ts",
    "ingest:child": "tsx src/modules/ingestion/run-parallel-child-ingestion-cli.ts",
    "ingest:child:seq": "tsx src/modules/ingestion/run-child-chunk-ingestion-cli.ts",
    "audit:corpus": "tsx src/modules/audit/run-corpus-audit-cli.ts",
    "audit:retrieval": "tsx src/modules/audit/run-retrieval-1000-cli.ts",
    "audit:adversarial": "tsx src/modules/audit/run-adversarial-300-cli.ts",
    "audit:e2e": "tsx src/modules/audit/run-e2e-1000-audit-cli.ts",
    "audit:live-llm": "tsx src/modules/audit/run-live-llm-e2e-cli.ts",
    "audit:live-llm:smoke": "tsx src/modules/audit/run-live-llm-e2e-cli.ts --smoke",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@google/generative-ai": "^0.24.1",
    "@talk-to-krisna/shared": "*",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.5",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.85.4",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.3",
    "resend": "^6.26.0",
    "typescript": "^5.7.3",
    "uuid": "^11.1.0",
    "vitest": "^3.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3"
  }
}
